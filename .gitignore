# Dependencies
node_modules/

# Build output — generated by tsc or vite, never committed
dist/
dist-ssr/

# Environment files — contain secrets, never committed
.env
.env.local
.env.*.local

# Prisma generated client — regenerated by `prisma generate`
# The generated client lands inside node_modules/.pnpm/... so this
# is a belt-and-suspenders guard for any future outputDirectory change.
src/generated/prisma/

# Editor and OS artefacts
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
.vscode/*
!.vscode/extensions.json

# pnpm
.pnpm-debug.log*
